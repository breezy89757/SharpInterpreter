<Project Sdk="Microsoft.NET.Sdk.WebAssembly">

  <PropertyGroup>
    <!-- The runner page: .NET + Roslyn in WebAssembly, run in a Web Worker (wwwroot/worker.js) of a page a
         host embeds hidden (see host/sharp-interpreter.js). -->
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- [JSExport] marshalling needs it. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- worker.js imports _framework/dotnet.js by name: workers have no import maps to resolve fingerprints. -->
    <WasmFingerprintAssets>false</WasmFingerprintAssets>
    <!-- Scripts can call any BCL API, so nothing may be trimmed away. -->
    <PublishTrimmed>false</PublishTrimmed>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Roslyn's translated messages are of no use with invariant globalization. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SharpInterpreter.Engine\SharpInterpreter.Engine.csproj" />
  </ItemGroup>

</Project>
